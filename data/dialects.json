  "poems": [
    {
      "title": "बहिणाबाईंची कविता",
      "poet": "बहिणाबाई",
      "dialect": "अहिराणी",
      "lines": [
        "माझा देश माझा देश",
        "हा माझा देश आहे",
        "यात रंग अनेक आहेत",
        "यात भाषा अनेक आहेत",
        "प्रत्येक भाषेच आहे महत्त्व",
        "प्रत्येक बोलीच आहे प्रेम"
      ],
      "meaning": "माझ्या देशात भाषिक वैविध्य आहे आणि प्रत्येक भाषेला सन्मान दिला पाहिजे."
    },
    {
      "title": "भाषेचे गाणे",
      "poet": "लोककवी",
      "dialect": "वारली",
      "lines": [
        "आमची भाषा आमचा अभिमान",
        "वारली बोलू आम्ही दिवसरात",
        "मराठी आहे आमची मातृभाषा",
        "बोली आहे आमचा अस्तित्व",
        "एकत्र राहू एकत्र बोलू",
        "भाषिक एकता निर्माण करू"
      ],
      "meaning": "वारली भाषेत दिवसरात बोलतो आणि भाषिक एकता निर्माण करतो."
    },
    {
      "title": "भाषा म्हणजे ओळख",
      "poet": "शिक्षक/विद्यार्थी",
      "dialect": "वैदर्भी",
      "lines": [
        "भाषा म्हणजे आपली ओळख",
        "बोली म्हणजे आपुलकीची नात",
        "एकत्र राहू भाषिक वैविध्यात",
        "आपण साजरे करू सण"
      ],
      "meaning": "भाषा आणि बोली ही आपली ओळख आहेत. विविध भाषा बोलणारे लोक एकत्र राहून सण साजरे करतात."
    }
  ],
